<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".DetalleOrdenActivity">

    <Button
        android:id="@+id/btnVolver"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minWidth="0dp"
        android:minHeight="0dp"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:paddingLeft="10dp"
        android:paddingTop="4dp"
        android:paddingRight="10dp"
        android:paddingBottom="4dp"
        android:layout_marginTop="36dp"
        android:layout_marginStart="16dp"
        android:text="&lt; Volver"
        android:textSize="14sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:padding="24dp"
        app:layout_constraintTop_toBottomOf="@id/btnVolver"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvDetalleTitulo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Detalle Completo de Orden"
                android:textSize="24sp"
                android:textStyle="bold"
                android:layout_marginBottom="24dp"/>

            <TextView
                android:id="@+id/tvDetalleID"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="14sp"
                android:textColor="#757575"
                tools:text="ID Orden: 1"
                android:layout_marginBottom="8dp"/>

            <TextView
                android:id="@+id/tvDetalleFecha"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="14sp"
                android:textColor="#757575"
                tools:text="Fecha ingreso: 10-10-2026"
                android:layout_marginBottom="16dp"/>

            <TextView
                android:id="@+id/tvDetalleEquipo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="20sp"
                android:textStyle="bold"
                tools:text="Samsung Galaxy S22"
                android:layout_marginBottom="4dp"/>

            <TextView
                android:id="@+id/tvDetalleSerie"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="16sp"
                tools:text="S/N: SN123"
                android:layout_marginBottom="16dp"/>

            <TextView
                android:id="@+id/tvDetalleEstado"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="18sp"
                android:textColor="#FF9800"
                android:textStyle="bold"
                tools:text="Estado: En diagnostico"
                android:layout_marginBottom="16dp"/>

            <TextView
                android:id="@+id/tvDetalleDiagnostico"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="16sp"
                tools:text="Diagnostico: Pantalla rota"
                android:layout_marginBottom="12dp"/>

            <TextView
                android:id="@+id/tvDetalleEvidencia"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="14sp"
                android:textColor="#424242"
                tools:text="Evidencia: Sin danos adicionales"
                android:layout_marginBottom="12dp"/>

            <TextView
                android:id="@+id/tvDetalleGarantia"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="14sp"
                android:textColor="#1976D2"
                android:textStyle="bold"
                tools:text="Garantia: 90 dias vigente"
                android:layout_marginBottom="8dp"/>

            <TextView
                android:id="@+id/tvDetalleMantencion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="14sp"
                android:textColor="#388E3C"
                tools:text="Proxima mantencion: 15-04-2027"
                android:layout_marginBottom="16dp"/>

            <TextView
                android:id="@+id/tvDetalleCosto"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="18sp"
                android:textColor="#4CAF50"
                android:textStyle="bold"
                tools:text="Costo: $150000.0"
                android:layout_marginBottom="12dp"/>

            <TextView
                android:id="@+id/tvDetalleAutorizado"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginBottom="16dp"
                tools:text="Requiere autorizacion: SI" />

            <LinearLayout
                android:id="@+id/layoutAprobacion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="16dp"
                android:visibility="gone">

                <Button
                    android:id="@+id/btnRechazarOrden"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    android:backgroundTint="#F44336"
                    android:text="Rechazar" />

                <Button
                    android:id="@+id/btnAprobarOrden"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:backgroundTint="#4CAF50"
                    android:text="Aprobar" />
            </LinearLayout>

            <Button
                android:id="@+id/btnGenerarPdf"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:text="Descargar Comprobante PDF"
                android:textSize="16sp" />

        </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>