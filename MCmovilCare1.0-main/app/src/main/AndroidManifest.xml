<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Requerido para consumir la API REST de prueba y sincronizar el estado e historial de los equipos del cliente. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Requerido para que el cliente pueda escanear códigos QR de sus equipos o subir evidencias en sus solicitudes. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <!-- Requerido en Android 13+ para enviar alertas al cliente sobre cambios de estado en sus órdenes, autorizaciones pendientes o próximas mantenciones. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Requerido (hasta Android 12) para que el cliente pueda descargar y guardar en su dispositivo los informes técnicos y comprobantes de garantía. -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.MCMovilCare"
        tools:targetApi="31">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>